{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dollyt",
  "version": "1.0.5",
  "identifier": "com.zfusions.dollyt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dollyt",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost asset: https://asset.localhost; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://*.googlevideo.com https://*.youtube.com https://youtube.com https://www.youtube.com https://i.ytimg.com https://*.ytimg.com; img-src 'self' data: blob: asset: https://i.ytimg.com https://*.ytimg.com; media-src 'self' blob: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/dollyt-cache/**", "$LOCALAPPDATA/Dollyt/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1NkYxQzBDMDRDM0U3RjkKUldUNTU4TUVEQnh2MVFWSjZKS3d4ZHE3K1NTMGd1SGVMTGpGZWo0N3RwaC9aZlhqRngwUXRGZ0sK",
      "endpoints": [
        "https://github.com/zFusions/Dollyt/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
